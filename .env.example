# Use a separate TEST bot. Never reuse a production polling token here.
MISAKA_BOT_TOKEN=
MISAKA_ADMIN_IDS=
MISAKA_DATA_DIR=data/misaka
MISAKA_LOG_LEVEL=INFO
MISAKA_POLLING_TIMEOUT=30
MISAKA_REQUEST_TIMEOUT=60
MISAKA_DROP_PENDING_UPDATES=false

# Optional lookup services. Never put live keys in this example or send them to logs.
MISAKA_EXCHANGE_RATE_API_KEY=
MISAKA_OPENWEATHER_API_KEY=
MISAKA_QWEATHER_API_KEY=
MISAKA_QWEATHER_API_HOST=
# Public Open-Meteo endpoints are for non-commercial use; disable them when not appropriate.
MISAKA_OPEN_METEO_ENABLED=true

# Optional override for the AI storage key (64 hexadecimal characters).
# First installation creates ai-master.key in MISAKA_DATA_DIR automatically.
# Persist and privately back up this key with the database; never regenerate it for existing data.
# Existing deployments using this environment key must keep the original value.
# AI calls remain off until a superadmin completes the WebUI quick setup.
MISAKA_AI_MASTER_KEY=
# References use env:OPENAI, env:ANTHROPIC, env:GOOGLE, env:DEEPSEEK in AI settings.
MISAKA_AI_SECRET_OPENAI=
MISAKA_AI_SECRET_ANTHROPIC=
MISAKA_AI_SECRET_GOOGLE=
MISAKA_AI_SECRET_DEEPSEEK=

# Optional dashboard. Mini App needs only the bot token and a fixed HTTPS origin.
MISAKA_WEB_ENABLED=false
MISAKA_WEB_HOST=127.0.0.1
MISAKA_WEB_PORT=8080
MISAKA_PUBLIC_BASE_URL=
# Optional pair for ordinary browser OIDC login; leave BOTH empty for Mini App only.
MISAKA_OIDC_CLIENT_ID=
MISAKA_OIDC_CLIENT_SECRET=
