# Build context allowlist. No legacy, runtime state, credentials or repository metadata.
**
!package.json
!package-lock.json
!LICENSE
!tsconfig.json
!tsconfig.build.json
!scripts/
!scripts/build-sandbox.mjs
!scripts/sandbox-runner.c
!scripts/sandbox-smoke.mjs
!src/
!src/**
!shared/
!shared/**
!webui/
!webui/package.json
!webui/tsconfig.json
!webui/vite.config.ts
!webui/index.html
!webui/src/
!webui/src/**

# Explicit exclusions also apply inside allowed source directories.
**/node_modules/
**/dist/
**/.env
**/.env.*
**/.git/
**/.kilo/
**/data/
**/logs/
**/*.log
**/*.tmp
legacy/
tests/
test-results/
playwright-report/
